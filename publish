#!/usr/bin/env bash
# Publish the blog: lint, commit, push, then wait for GitHub Pages to build
# the exact commit we pushed and confirm it went live.
#
#   ./publish                 # commit all changes with a generated message
#   ./publish -m "message"    # ...with your own message
#   ./publish --check         # lint and show what would be published, then stop
#
set -euo pipefail

REPO="VedantPimpley/blog"
SITE="https://vedantpimpley.github.io/blog/"
cd "$(dirname "$(readlink -f "$0")")"

msg=""
check_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message) msg="${2:-}"; shift 2 ;;
    --check)      check_only=1; shift ;;
    -h|--help)    sed -n '2,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)            echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
warn() { printf '\033[33mwarn\033[0m  %s\n' "$1"; }
die()  { printf '\033[31merror\033[0m %s\n' "$1" >&2; exit 1; }

# --- what changed -----------------------------------------------------------
if [ -z "$(git status --porcelain)" ]; then
  bold "Nothing to publish — working tree is clean."
  exit 0
fi
bold "Changes to publish:"
git status --short
echo

# --- lint the posts we are about to publish ---------------------------------
problems=0
today=$(date +%Y-%m-%d)
while IFS= read -r f; do
  [ -f "$f" ] || continue
  base=$(basename "$f")

  [[ "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-.+\.(md|markdown|html)$ ]] \
    || warn "$base: filename is not YYYY-MM-DD-slug.md — Jekyll will ignore it"

  head -1 "$f" | grep -qx -- '---' \
    || die "$base: no front matter. The file must begin with a line of exactly ---"

  d="${base:0:10}"
  if [[ "$d" > "$today" ]]; then
    warn "$base: dated $d, in the future — Jekyll will not publish it until then"
  fi

  # A non-blank, non-list line directly after a list item is folded INTO that
  # item by kramdown (lazy continuation). Bit us once already.
  lazy=$(awk '
      /^[[:space:]]*([0-9]+[.)]|[-*+])[[:space:]]+/ { inlist=1; next }
      inlist && /^[[:space:]]*$/                    { inlist=0; next }
      inlist && !/^[[:space:]]{2,}/                 { print NR; exit }
    ' "$f")
  if [ -n "$lazy" ]; then
    warn "$base: line $lazy runs straight on from a list item;"
    warn "       add a blank line or kramdown folds it into that bullet"
    problems=1
  fi
done < <(git status --porcelain -- '_posts' '_drafts' | awk '{print $NF}')

[ "$problems" -eq 1 ] && echo
if [ "$check_only" -eq 1 ]; then
  bold "--check: nothing committed or pushed."
  exit 0
fi

# --- commit and push --------------------------------------------------------
if [ -z "$msg" ]; then
  posts=$(git status --porcelain -- '_posts' | awk '{print $NF}' | xargs -r -n1 basename \
          | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//; s/\.(md|markdown|html)$//' | paste -sd', ' -)
  msg="${posts:-site update}"
fi

git add -A
git commit -q -m "$msg"
sha=$(git rev-parse HEAD)
git push -q origin "$(git rev-parse --abbrev-ref HEAD)"
bold "Pushed ${sha:0:7} — \"$msg\""

# --- wait for Pages to build THIS commit ------------------------------------
# Matching on .commit matters: status alone can read "built" from the previous
# build while the new one has not started.
printf 'Building'
deadline=$(( $(date +%s) + 300 ))
while :; do
  read -r bstatus bcommit berror < <(
    gh api "repos/$REPO/pages/builds/latest" \
      --jq '[.status, (.commit // "-"), (.error.message // "-")] | @tsv' 2>/dev/null || echo "- - -"
  )

  if [ "$bcommit" = "$sha" ]; then
    case "$bstatus" in
      built)
        code=$(curl -s -o /dev/null -w '%{http_code}' "$SITE")
        echo
        bold "Live at $SITE  (HTTP $code, built from ${sha:0:7})"
        [ "$code" = "200" ] || die "site returned $code — check $SITE"
        exit 0
        ;;
      errored|failed)
        echo
        die "build failed: $berror"
        ;;
    esac
  fi

  [ "$(date +%s)" -ge "$deadline" ] && {
    echo
    die "timed out after 5 min (last status: $bstatus). Check https://github.com/$REPO/deployments"
  }
  printf '.'
  sleep 10
done
